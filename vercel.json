{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/services/marketing-consulting", "destination": "/services/consulting", "permanent": true },
    { "source": "/services/website-consulting", "destination": "/services/website-production", "permanent": true },
    { "source": "/services/website-diagnosis", "destination": "/services/website-production", "permanent": true },
    { "source": "/marketing-types/consulting", "destination": "/marketing-types/consulting-contract", "permanent": true },
    { "source": "/cases/yetgiwa", "destination": "/cases/oldgiwa", "permanent": true },
    { "source": "/support/inquiry", "destination": "/contact?type=consulting&source=support-inquiry", "permanent": false },
    { "source": "/insights", "destination": "/blog", "permanent": true },
    { "source": "/insights/:slug", "destination": "/blog/:slug", "permanent": true }
  ],
  "rewrites": [
    { "source": "/support/notices/:slug", "destination": "/support/notices/detail?slug=:slug" },
    { "source": "/support/resources/:slug", "destination": "/support/resources/detail?slug=:slug" },
    { "source": "/blog/rss.xml", "destination": "/api/blog?mode=rss" },
    { "source": "/blog", "destination": "/api/blog?mode=list" },
    { "source": "/blog/:slug", "destination": "/api/blog?mode=detail&slug=:slug" }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/rss.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }
      ]
    },
    {
      "source": "/blog/rss.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
